{
  "name": "tether",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tether/web --filter @tether/chat dev",
    "dev:web": "pnpm --filter @tether/web dev",
    "dev:chat": "pnpm --filter @tether/chat dev",
    "test": "pnpm --filter @tether/chat --filter @tether/web test",
    "test:integration": "sh scripts/test-integration.sh",
    "db:migrate": "pnpm --filter @tether/chat db:migrate"
  }
}
